{
  "manifest_version": 3,
  "name": "Nerfed",
  "version": "1.0.0",
  "minimum_chrome_version": "105",
  "description": "A calmer YouTube: hide thumbnails, Shorts, comments and suggested videos, or switch to a table or search-only layout.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "Nerfed",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "css": [
        "hide-thumbnails.css",
        "hide-shorts.css",
        "hide-playables.css",
        "hide-channel-icons.css",
        "hide-comments.css",
        "hide-suggested.css",
        "table-layout.css",
        "search-only.css"
      ],
      "js": [
        "settings.js",
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
